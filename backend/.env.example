# Server Configuration
PORT=5000
NODE_ENV=development  # Set to 'development' for test card support, 'production' for real payments

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ehr-system

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (Mailchimp Transactional)
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_FROM_EMAIL=noreply@yourdomain.com
MAILCHIMP_FROM_NAME=EHR System

# Authorize.net Payment Gateway
# In development mode, test cards are accepted automatically (see TEST_CREDENTIALS.md)
# Test Card: 4111111111111111, Exp: 12/28, CVV: 123
AUTHORIZE_NET_API_LOGIN_ID=your-api-login-id
AUTHORIZE_NET_TRANSACTION_KEY=your-transaction-key
AUTHORIZE_NET_ENVIRONMENT=sandbox

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Frontend URL
FRONTEND_URL=http://localhost:3000
